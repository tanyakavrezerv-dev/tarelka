  "meta": {
    "schemaVersion": 1,
    "currency": "RUB",
    "unitOfMoney": "копейки, целые числа",
    "label": "демонстрационные цены",
    "dataSource": "цены ориентировочные, составлены по общему представлению о розничных ценах, без источника и без привязки к дате и региону. В интерфейсе подписывать как «демонстрационные»",
    "models": {
      "fixed": "priceKopecks за упаковку packSizeG",
      "weight": "priceKopecksPerKg за килограмм, платится фактический вес",
      "per_piece": "priceKopecks за штуку, вес штуки gramsPerPiece"
    },
    "formulas": {
      "menuCost": "«по меню»: пропорционально нужному количеству. fixed: need*priceKopecks/packSizeG, weight: need*priceKopecksPerKg/1000, per_piece: need/gramsPerPiece*priceKopecks",
      "receiptCost": "«в чеке»: считается от toCover = max(0, need - остаток в кладовке). fixed: ceil(toCover/packSizeG)*priceKopecks, weight: toCover*priceKopecksPerKg/1000, per_piece: ceil(toCover/gramsPerPiece)*priceKopecks",
      "rounding": "каждая строка округляется до целой копейки (0,5 вверх), итог равен сумме округлённых строк"
    },
    "storeRule": "цена не зависит от магазина, магазин влияет только на группировку списка покупок. storeId это магазин по умолчанию"
